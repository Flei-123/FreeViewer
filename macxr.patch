From 2442ec72df76aaf1e526b2e7087dc11523d6cdf0 Mon Sep 17 00:00:00 2001
From: Justin <justin@fleitec.com>
Date: Tue, 4 Aug 2026 12:55:12 +0000
Subject: [PATCH] Mac-Build auch als X-Remote: eigener Job (Marke +
 Lizenz-Merkmal), Zip geht direkt zum Relay (noversion)

---
 .github/workflows/mac.yml | 106 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 106 insertions(+)

diff --git a/.github/workflows/mac.yml b/.github/workflows/mac.yml
index 76aa1cc..4767a55 100644
--- a/.github/workflows/mac.yml
+++ b/.github/workflows/mac.yml
@@ -28,6 +28,7 @@ jobs:
       AC_APPLE_ID: ${{ secrets.AC_APPLE_ID }}
       AC_PASSWORD: ${{ secrets.AC_PASSWORD }}
       AC_TEAM_ID: ${{ secrets.AC_TEAM_ID }}
+      FV_UPLOAD_TOKEN: ${{ secrets.FV_UPLOAD_TOKEN }}
     steps:
       - uses: actions/checkout@v4
 
@@ -114,3 +115,108 @@ jobs:
           name: freeviewer-macos-app
           path: target/FreeViewer.app
           if-no-files-found: warn
+
+  # ----------------------------------------------------------- X-Remote ---
+  # Dasselbe Programm als Marke X-Remote (Lizenz-Merkmal an). Das fertige
+  # Zip wird DIREKT zum Relay hochgeladen - dort liegt es neben der
+  # Windows-Exe unter https://remote.fleitec.com/fv/dist/.
+  xremote:
+    name: X-Remote bauen + zum Relay laden
+    runs-on: macos-14
+    env:
+      MACOS_CERT_P12: ${{ secrets.MACOS_CERT_P12 }}
+      MACOS_CERT_PASSWORD: ${{ secrets.MACOS_CERT_PASSWORD }}
+      MACOS_SIGN_IDENTITY: ${{ secrets.MACOS_SIGN_IDENTITY }}
+      AC_APPLE_ID: ${{ secrets.AC_APPLE_ID }}
+      AC_PASSWORD: ${{ secrets.AC_PASSWORD }}
+      AC_TEAM_ID: ${{ secrets.AC_TEAM_ID }}
+      FV_UPLOAD_TOKEN: ${{ secrets.FV_UPLOAD_TOKEN }}
+      FV_BRAND_NAME: X-Remote
+      FV_BRAND_EXE: x-remote.exe
+      FV_BRAND_DIR: X-Remote
+      FV_BRAND_PUBLISHER: Xoffi
+      FV_BRAND_SLUG: xoffi
+      FV_BRAND_WEB: https://remote.fleitec.com
+      FV_BRAND_FEED: https://remote.fleitec.com/fv/dist/version-xoffi.json
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Rust
+        uses: dtolnay/rust-toolchain@stable
+
+      - name: Bauen (mit Lizenz-Merkmal)
+        run: cargo build --release --features license
+
+      - name: Testen
+        run: cargo test --release --features license
+
+      - name: App-Bundle schnueren
+        run: |
+          VERSION=$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2)
+          echo "Version: $VERSION"
+          APP="target/X-Remote.app"
+          mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
+          cp target/release/freeviewer "$APP/Contents/MacOS/X-Remote"
+          chmod 755 "$APP/Contents/MacOS/X-Remote"
+          cat > "$APP/Contents/Info.plist" <<PLIST
+          <?xml version="1.0" encoding="UTF-8"?>
+          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+          <plist version="1.0">
+          <dict>
+            <key>CFBundleName</key><string>X-Remote</string>
+            <key>CFBundleDisplayName</key><string>X-Remote</string>
+            <key>CFBundleIdentifier</key><string>com.xoffi.xremote</string>
+            <key>CFBundleExecutable</key><string>X-Remote</string>
+            <key>CFBundlePackageType</key><string>APPL</string>
+            <key>CFBundleShortVersionString</key><string>$VERSION</string>
+            <key>CFBundleVersion</key><string>$VERSION</string>
+            <key>LSMinimumSystemVersion</key><string>12.3</string>
+            <key>NSHighResolutionCapable</key><true/>
+            <key>NSCameraUsageDescription</key><string>X-Remote nutzt die Kamera nur, wenn du sie in einem Meeting einschaltest.</string>
+            <key>NSMicrophoneUsageDescription</key><string>X-Remote nutzt das Mikrofon nur, wenn du es in einem Meeting oder einer Sitzung einschaltest.</string>
+          </dict>
+          </plist>
+          PLIST
+
+      - name: Signieren (nur mit hinterlegtem Zertifikat)
+        if: env.MACOS_CERT_P12 != ''
+        run: |
+          echo "$MACOS_CERT_P12" | base64 --decode > /tmp/cert.p12
+          security create-keychain -p bau bau.keychain
+          security default-keychain -s bau.keychain
+          security unlock-keychain -p bau bau.keychain
+          security import /tmp/cert.p12 -k bau.keychain -P "$MACOS_CERT_PASSWORD" -T /usr/bin/codesign
+          security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k bau bau.keychain
+          codesign --force --deep --options runtime --timestamp             --sign "$MACOS_SIGN_IDENTITY" target/X-Remote.app
+          codesign --verify --strict --verbose=2 target/X-Remote.app
+
+      - name: Notarisieren (nur mit hinterlegten Zugangsdaten)
+        if: env.AC_APPLE_ID != ''
+        run: |
+          ditto -c -k --keepParent target/X-Remote.app /tmp/X-Remote.zip
+          xcrun notarytool submit /tmp/X-Remote.zip \
+            --apple-id "$AC_APPLE_ID" --password "$AC_PASSWORD" --team-id "$AC_TEAM_ID" --wait
+          xcrun stapler staple target/X-Remote.app
+          xcrun stapler validate target/X-Remote.app
+
+      - name: Verteil-Zip erzeugen (Permissions bleiben erhalten)
+        run: |
+          chmod 755 target/X-Remote.app/Contents/MacOS/X-Remote
+          ditto -c -k --keepParent --sequesterRsrc target/X-Remote.app target/X-Remote-macOS.zip
+          unzip -l target/X-Remote-macOS.zip
+          zipinfo target/X-Remote-macOS.zip | grep MacOS/X-Remote
+
+      - name: Ergebnis einsammeln (Artefakt zur Diagnose)
+        uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: x-remote-macos-arm64
+          path: target/X-Remote-macOS.zip
+          if-no-files-found: warn
+
+      - name: "Zum Relay hochladen (noversion - version.json bleibt unberuehrt)"
+        if: env.FV_UPLOAD_TOKEN != ''
+        run: |
+          VERSION=$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2)
+          curl -fsS --data-binary @target/X-Remote-macOS.zip \
+            "https://freeviewer.fleitec.com/fv/publish?token=$FV_UPLOAD_TOKEN&version=$VERSION&name=X-Remote-macOS.zip&noversion=1&notes=X-Remote-macOS"
-- 
2.39.5
