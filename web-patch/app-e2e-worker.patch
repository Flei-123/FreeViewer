+/**
+ * With E2E on, only H.264 video can be protected (the frame format keeps the
+ * NAL structure readable for the server). Offer nothing else, so a browser
+ * never negotiates VP8/VP9 and sends clear frames (r62). No H.264 -> the
+ * sender drops its frames (fail closed in e2e.js) and we say so.
+ */
+function e2eVideoCodecs(transceiver) {
+  if (!state.e2eKey) return;
+  try {
+    const caps = RTCRtpSender.getCapabilities('video');
+    const h264 = caps.codecs.filter((c) => /^video\/(h264|rtx)$/i.test(c.mimeType));
+    if (!h264.some((c) => /h264/i.test(c.mimeType))) {
+      log('Ende-zu-Ende: dieser Browser hat kein H.264 - Kamera/Bildschirm werden nicht gesendet.');
+      return;
+    }
+    transceiver.setCodecPreferences(h264);
+  } catch (e) {
+    log('Ende-zu-Ende: Codec-Wahl nicht moeglich: ' + e.message);
+  }
+}
